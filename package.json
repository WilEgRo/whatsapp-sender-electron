{
  "name": "whatsapp-sender-electron",
  "version": "3.5.4", 
  "description": "migración de la primera aplicación de WhatsApp Sender a Electron",
  "main": "src/main/main.js",
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "start": "electron .",
    "start:desktop": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "dist": "npm run build"
  },
  "keywords": [
    "whatsapp",
    "electron",
    "messaging"
  ],
  "author": "Wilson Eguez Rojas",
  "license": "MIT",
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-node-canvas": "^5.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "formidable": "^3.5.2",
    "fs-extra": "^11.3.0",
    "iconv-lite": "^0.6.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite3": "^5.1.7",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "build": {
    "appId": "com.CiberGuard.whatsapp-sender",
    "productName": "WhatsApp Sender",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
